@page
@model Organizer.Web.Pages.Events.DetailsModel
@{ ViewData["Title"] = Model.EventItem.Title; }
<section class="event-detail-hero"><div class="container detail-hero-grid"><div><div class="d-flex gap-2 flex-wrap mb-3"><span class="event-tag">@Model.EventItem.EventType</span>@if(Model.EventItem.HasEnded){<span class="status-chip ended">Ended</span>}else if(Model.EventItem.IsSoldOut){<span class="status-chip sold">Sold Out</span>}else{<span class="status-chip live">Booking Open</span>}</div><h1>@Model.EventItem.Title</h1><p>@Model.EventItem.Description</p><small>Curated by @Model.EventItem.OrganizerName</small></div><div class="detail-date-card"><span>@Model.EventItem.EventDate.ToString("dddd")</span><strong>@Model.EventItem.EventDate.ToString("dd")</strong><span>@Model.EventItem.EventDate.ToString("MMMM yyyy")</span>@if(Model.EventItem.EndDate.Date != Model.EventItem.EventDate.Date){<small>Ends @Model.EventItem.EndDate.ToString("dd MMM yyyy")</small>}</div></div></section>
<div class="container detail-body"><div class="detail-main"><div class="detail-fact-grid"><div><span>Date</span><strong>@Model.EventItem.EventDate.ToString("dd MMM yyyy")@(Model.EventItem.EndDate.Date != Model.EventItem.EventDate.Date ? $" – {Model.EventItem.EndDate:dd MMM yyyy}" : "")</strong></div><div><span>Time</span><strong>@Model.EventItem.StartTime.ToString(@"hh\:mm") – @Model.EventItem.EndTime.ToString(@"hh\:mm")</strong></div><div><span>Venue</span><strong>@Model.EventItem.Venue</strong></div><div><span>Location</span><strong>@Model.EventItem.Location</strong></div><div><span>Hosted by</span><strong>@Model.EventItem.OrganizerName</strong></div><div><span>Tickets sold</span><strong>@Model.EventItem.SoldCount / @Model.EventItem.TotalCapacity</strong></div></div>
<section class="ticket-section"><div class="section-title-row compact"><div><span class="kicker">Choose your place</span><h2>Ticket options</h2></div><span class="live-stock">● Shared live availability</span></div>
@if(Model.EventItem.HasEnded){<div class="soft-alert">This event has ended and ticket sales are closed.</div>}
else if(Model.EventItem.IsSoldOut){<div class="soft-alert error">Every ticket category is sold out.</div>}
else {<div class="ticket-grid">@foreach (var tier in Model.EventItem.TicketTiers.OrderBy(item => item.SortOrder)){<article class="ticket-card @(tier.AvailableCount == 0 ? "sold-out" : "")"><h3>@tier.Name</h3><p>@tier.Description</p><strong>LKR @tier.Price.ToString("N2")</strong><span>@tier.AvailableCount of @tier.Capacity available</span>@if(tier.AvailableCount > 0){<a asp-page="/Checkout/Index" asp-route-eventId="@Model.EventItem.Id" asp-route-ticketTierId="@tier.Id" class="btn-coral">Choose @tier.Name</a>}else{<button class="btn-muted" disabled>Sold Out</button>}</article>}</div>}
</section></div>
<aside class="host-note-card"><span class="signature">A note from Isuru Akash</span><p>I personally review the guest list and event run sheet before doors open. Keep your booking reference on your phone for a smooth check-in.</p><hr/><small>Questions before booking?</small><a href="mailto:isuru@sparklingeventskandy.lk">isuru@sparklingeventskandy.lk</a><a href="tel:+94768452190">+94 76 845 2190</a></aside></div>
