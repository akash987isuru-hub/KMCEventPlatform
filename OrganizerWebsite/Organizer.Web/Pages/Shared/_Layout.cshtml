<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07111b" />
    <title>@ViewData["Title"] - Sparkling Events Kandy</title>
    <meta name="description" content="Discover and book ticketed events created by Sparkling Events Kandy." />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <nav class="navbar navbar-expand-lg">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index" aria-label="Sparkling Events Kandy home">
                <span class="brand-monogram">S</span>
                <span class="brand-copy">
                    <strong>Sparkling Events Kandy</strong>
                    <small>Ticketed experiences across Kandy</small>
                </span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNav">
                <ul class="navbar-nav ms-auto align-items-lg-center gap-lg-2">
                    <li class="nav-item"><a class="nav-link" asp-page="/Index">Home</a></li>
                    <li class="nav-item"><a class="nav-link" asp-page="/Events/Index">Events</a></li>
                    <li class="nav-item"><a class="studio-link" asp-page="/Studio/Index">Event desk</a></li>
                </ul>
            </div>
        </div>
    </nav>
</header>

<main>@RenderBody()</main>

<footer class="site-footer">
    <div class="container footer-grid organizer-footer-clean">
        <div>
            <strong>Sparkling Events Kandy</strong>
            <p>Modern ticketed music, cultural and learning experiences created for the Kandy community.</p>
        </div>
        <div>
            <span class="footer-label">Explore</span>
            <a asp-page="/Events/Index">Upcoming events</a>
            <a asp-page="/Studio/Index">Event management desk</a>
        </div>
        <div>
            <span class="footer-label">Connected platform</span>
            <p>Ticket availability is synchronized with the KMC Event Platform.</p>
        </div>
    </div>
    <div class="container footer-bottom">
        <span>© 2026 Sparkling Events Kandy</span>
        <span>Secure event discovery and shared ticket inventory.</span>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
