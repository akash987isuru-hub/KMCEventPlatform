@page
@model Organizer.Web.Pages.Checkout.IndexModel
@{ ViewData["Title"] = "Book Tickets"; var selectedTier = Model.EventItem.TicketTiers.FirstOrDefault(item => item.Id == Model.Input.TicketTierId); }
<section class="page-intro checkout-intro"><div class="container"><span class="kicker">Sparkling secure demo checkout</span><h1>Build your booking.</h1><p>@Model.EventItem.Title · @Model.EventItem.EventDate.ToString("dd MMM yyyy")@(Model.EventItem.EndDate.Date != Model.EventItem.EventDate.Date ? $" – {Model.EventItem.EndDate:dd MMM yyyy}" : "")</p></div></section>
<div class="container checkout-layout"><form method="post" class="checkout-form"><input asp-for="Input.EventId" type="hidden"/><input asp-for="Input.ExternalEventCode" type="hidden"/><div asp-validation-summary="ModelOnly" class="soft-alert error"></div>
<section class="form-paper"><span class="form-step">01 · Guest & ticket details</span><div class="row g-3"><div class="col-md-6"><label asp-for="Input.CustomerName"></label><input asp-for="Input.CustomerName" class="form-control"/><span asp-validation-for="Input.CustomerName"></span></div><div class="col-md-6"><label asp-for="Input.CustomerEmail"></label><input asp-for="Input.CustomerEmail" class="form-control"/><span asp-validation-for="Input.CustomerEmail"></span></div><div class="col-md-6"><label asp-for="Input.CustomerPhone"></label><input asp-for="Input.CustomerPhone" class="form-control"/><span asp-validation-for="Input.CustomerPhone"></span></div><div class="col-md-3"><label asp-for="Input.Quantity"></label><input asp-for="Input.Quantity" id="ticketQuantity" class="form-control" min="1" max="@(selectedTier is null ? 10 : Math.Min(10, selectedTier.AvailableCount))" data-price="@(selectedTier?.Price ?? 0)"/><span asp-validation-for="Input.Quantity"></span></div><div class="col-md-3"><label asp-for="Input.TicketTierId"></label><select asp-for="Input.TicketTierId" id="ticketTier" class="form-select">@foreach(var tier in Model.EventItem.TicketTiers.Where(item => item.AvailableCount > 0)){<option value="@tier.Id" data-price="@tier.Price" data-max="@tier.AvailableCount">@tier.Name · LKR @tier.Price.ToString("N0")</option>}</select><span asp-validation-for="Input.TicketTierId"></span></div></div></section>
<section class="form-paper"><span class="form-step">02 · Demo payment</span><p class="form-help">Use any 16-digit test card number. Only the card brand and final four digits are stored.</p><div class="row g-3"><div class="col-md-6"><label asp-for="Input.CardHolderName"></label><input asp-for="Input.CardHolderName" class="form-control"/><span asp-validation-for="Input.CardHolderName"></span></div><div class="col-md-6"><label asp-for="Input.CardNumber"></label><input asp-for="Input.CardNumber" class="form-control" placeholder="4111 1111 1111 1111"/><span asp-validation-for="Input.CardNumber"></span></div><div class="col-md-4"><label asp-for="Input.ExpiryMonth"></label><input asp-for="Input.ExpiryMonth" class="form-control"/><span asp-validation-for="Input.ExpiryMonth"></span></div><div class="col-md-4"><label asp-for="Input.ExpiryYear"></label><input asp-for="Input.ExpiryYear" class="form-control"/><span asp-validation-for="Input.ExpiryYear"></span></div><div class="col-md-4"><label asp-for="Input.Cvv"></label><input asp-for="Input.Cvv" class="form-control" maxlength="3"/><span asp-validation-for="Input.Cvv"></span></div></div></section>
<button type="submit" class="btn-coral btn-wide">Pay LKR <span id="checkoutTotal">@((selectedTier?.Price ?? 0) * Model.Input.Quantity).ToString("N2")</span> &amp; confirm</button></form>
<aside class="order-note"><span class="kicker">Live order summary</span><h2>@Model.EventItem.Title</h2><dl><div><dt>Date</dt><dd>@Model.EventItem.EventDate.ToString("dd MMM yyyy")</dd></div><div><dt>Venue</dt><dd>@Model.EventItem.Venue</dd></div><div><dt>Ticket</dt><dd id="summaryTicket">@(selectedTier?.Name ?? "Select a ticket")</dd></div><div><dt>Unit price</dt><dd id="summaryPrice">LKR @(selectedTier?.Price.ToString("N2") ?? "0.00")</dd></div><div><dt>Total</dt><dd id="summaryTotal">LKR @((selectedTier?.Price ?? 0) * Model.Input.Quantity).ToString("N2")</dd></div></dl><p>Stock updates instantly on Sparkling Events Kandy and KMC Web.</p></aside></div>
@section Scripts { <partial name="_ValidationScriptsPartial"/><script>(()=>{const tier=document.getElementById('ticketTier'),qty=document.getElementById('ticketQuantity'),total=document.getElementById('checkoutTotal'),sumTotal=document.getElementById('summaryTotal'),sumPrice=document.getElementById('summaryPrice'),sumTicket=document.getElementById('summaryTicket');const update=()=>{const option=tier?.selectedOptions?.[0];const price=Number(option?.dataset.price||0);const max=Math.min(10,Number(option?.dataset.max||10));if(qty){qty.max=max; if(Number(qty.value)>max)qty.value=max;}const amount=price*Math.max(1,Number(qty?.value||1));const formatted=amount.toLocaleString('en-LK',{minimumFractionDigits:2,maximumFractionDigits:2});if(total)total.textContent=formatted;if(sumTotal)sumTotal.textContent=`LKR ${formatted}`;if(sumPrice)sumPrice.textContent=`LKR ${price.toLocaleString('en-LK',{minimumFractionDigits:2})}`;if(sumTicket)sumTicket.textContent=option?.textContent?.split('·')[0]?.trim()||'Select a ticket';};tier?.addEventListener('change',update);qty?.addEventListener('input',update);update();})();</script> }
