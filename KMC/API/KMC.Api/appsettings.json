{
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=KMCEventDb;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "KMC.Api",
    "Audience": "KMC.Client",
    "ExpirationMinutes": 60
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Database": {
    "ApplyMigrationsOnStartup": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "HttpsRedirection": {
    "Enabled": true
  },
  "PartnerIntegration": {
    "ApiKey": "organizer-demo-secret-key"
  },
  "OrganizerIntegration": {
    "BaseUrl": "https://localhost:7225/"
  }
}
