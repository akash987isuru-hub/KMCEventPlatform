@page
@model KMC.Web.Pages.Registrations.IndexModel

@{
    ViewData["Title"] = "My Tickets";
}

<div class="container py-5 participant-tickets-page">
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge bg-warning text-dark mb-2">Public User Interface</span>
            <h1 class="display-5 fw-bold mb-1">My Tickets</h1>
            <p class="text-muted lead mb-0">
                Review ticket categories, payment references and registration status, or download a PDF ticket for event entry.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="/Participant/Index"
               class="btn btn-outline-dark">
                Dashboard
            </a>
            <a asp-page="/Events/Index"
               class="btn btn-kmc-gold">
                Buy Another Ticket
            </a>
        </div>
    </div>

    @if (TempData["RegistrationSuccess"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (TempData["RegistrationError"] is string errorMessage)
    {
        <div class="alert alert-danger">@errorMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    else if (Model.Registrations.Count == 0)
    {
        <div class="empty-state-card">
            <h2 class="h3 fw-bold">No tickets purchased yet</h2>
            <p>Select an event, choose a ticket category and complete the secure checkout.</p>
            <a asp-page="/Events/Index" class="btn btn-dark">Find an Event</a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var registration in Model.Registrations)
            {
                var isConfirmed = string.Equals(
                    registration.Status,
                    "Confirmed",
                    StringComparison.OrdinalIgnoreCase);

                var eventStart = registration.EventDate.Date.Add(
                    registration.StartTime);

                var canCancel = isConfirmed && eventStart > DateTime.Now;

                <div class="col-md-6 col-xl-4">
                    <article class="participant-ticket-card h-100">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                            <span class="badge bg-warning text-dark">@registration.TicketTierName</span>
                            <span class="badge @(isConfirmed ? "bg-success" : "bg-secondary")">
                                @registration.Status
                            </span>
                        </div>

                        <h2 class="h4 fw-bold">@registration.EventTitle</h2>
                        <p class="text-muted ticket-date-line mb-3">
                            @registration.EventDate.ToString("dd MMM yyyy") at
                            @registration.StartTime.ToString(@"hh\:mm")
                        </p>

                        <div class="ticket-record-grid">
                            <div>
                                <span>Ticket price</span>
                                <strong>LKR @registration.TicketPrice.ToString("N2") each</strong>
                            </div>
                            <div>
                                <span>Quantity</span>
                                <strong>@registration.Quantity ticket(s)</strong>
                            </div>
                            <div>
                                <span>Total paid</span>
                                <strong>LKR @registration.TotalAmount.ToString("N2")</strong>
                            </div>
                            <div>
                                <span>Payment</span>
                                <strong>@registration.PaymentStatus</strong>
                            </div>
                            <div>
                                <span>Card</span>
                                <strong>@(string.IsNullOrWhiteSpace(registration.CardDisplay) ? "Not available" : registration.CardDisplay)</strong>
                            </div>
                            <div>
                                <span>Reference</span>
                                <strong class="transaction-reference">
                                    @(string.IsNullOrWhiteSpace(registration.TransactionReference)
                                        ? "Not available"
                                        : registration.TransactionReference)
                                </strong>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            @if (isConfirmed)
                            {
                                <a asp-page="/Registrations/Index"
                                   asp-page-handler="DownloadReceipt"
                                   asp-route-registrationId="@registration.Id"
                                   class="btn btn-kmc-gold btn-sm">
                                    Download Receipt
                                </a>
                                <a asp-page="/Registrations/PrintTicket"
                                   asp-route-registrationId="@registration.Id"
                                   target="_blank"
                                   rel="noopener"
                                   class="btn btn-outline-info btn-sm">
                                    Print Ticket
                                </a>
                            }

                            <a asp-page="/Events/Details"
                               asp-route-id="@registration.EventId"
                               class="btn btn-outline-dark btn-sm">
                                View Event
                            </a>

                            @if (canCancel)
                            {
                                <form asp-page="/Registrations/Index"
                                      asp-page-handler="Cancel"
                                      method="post"
                                      onsubmit="return confirm('Cancel this ticket and mark the payment as refunded?');">
                                    <input type="hidden"
                                           name="registrationId"
                                           value="@registration.Id" />
                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">
                                        Cancel Ticket
                                    </button>
                                </form>
                            }
                        </div>
                    </article>
                </div>
            }
        </div>
    }
</div>
