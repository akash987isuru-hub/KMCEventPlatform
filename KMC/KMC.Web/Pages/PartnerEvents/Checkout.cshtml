@page
@model KMC.Web.Pages.PartnerEvents.CheckoutModel
@{
    ViewData["Title"] = "Secure Ticket Checkout";
    var selectedTier = Model.EventItem.TicketTiers.FirstOrDefault(
        item => item.Id == Model.Input.TicketTierId);
    var maximumQuantity = Math.Min(10, selectedTier?.AvailableCount ?? 1);
    var unitPrice = selectedTier?.Price ?? 0m;
}

<section class="page-hero page-hero-compact checkout-hero">
    <div class="container">
        <span class="eyebrow-pill"><span class="eyebrow-dot"></span>Secure KMC checkout</span>
        <h1>Complete your booking</h1>
        <p>@Model.EventItem.Title · hosted by @Model.EventItem.OrganizerName</p>
    </div>
</section>

<div class="container partner-checkout-layout checkout-page-shell">
    <form method="post"
          class="modern-form-card checkout-form-card"
          data-unit-price="@unitPrice.ToString(System.Globalization.CultureInfo.InvariantCulture)"
          data-maximum-quantity="@maximumQuantity">
        <input asp-for="Input.PartnerEventId" type="hidden" />
        <input asp-for="Input.TicketTierId" type="hidden" />

        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="checkout-section-heading">
            <div>
                <span class="section-kicker">Selected admission</span>
                <h2>@(selectedTier?.Name ?? "Ticket")</h2>
            </div>
            <span class="checkout-price-chip">LKR @unitPrice.ToString("N2") each</span>
        </div>

        <div class="selected-ticket-panel">
            <div>
                <span>Ticket category</span>
                <strong>@(selectedTier?.Name ?? "Selected ticket")</strong>
                <small>@(selectedTier?.Description ?? "Admission to this connected event.")</small>
            </div>
            <div>
                <span>Availability</span>
                <strong>@(selectedTier?.AvailableCount ?? 0) remaining</strong>
                <small>Your chosen category is locked for this checkout.</small>
            </div>
        </div>

        <div class="checkout-field-block">
            <label asp-for="Input.Quantity" class="form-label">Number of tickets</label>
            <div class="quantity-control">
                <button type="button" class="quantity-button" data-quantity-action="decrease" aria-label="Decrease quantity">−</button>
                <input asp-for="Input.Quantity"
                       class="form-control"
                       min="1"
                       max="@maximumQuantity"
                       inputmode="numeric" />
                <button type="button" class="quantity-button" data-quantity-action="increase" aria-label="Increase quantity">+</button>
            </div>
            <span asp-validation-for="Input.Quantity" class="text-danger"></span>
        </div>

        <div class="checkout-divider"></div>

        <div class="checkout-section-heading">
            <div>
                <span class="section-kicker">Demo payment</span>
                <h2>Payment details</h2>
            </div>
            <span class="secure-payment-note">Secure test transaction</span>
        </div>

        <p class="checkout-help-text">
            Use a 16-digit test card. Only the card brand and final four digits are stored.
        </p>

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Input.CardHolderName" class="form-label"></label>
                <input asp-for="Input.CardHolderName"
                       class="form-control"
                       autocomplete="cc-name"
                       placeholder="Name printed on card" />
                <span asp-validation-for="Input.CardHolderName" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Input.CardNumber" class="form-label"></label>
                <div class="card-number-shell">
                    <input asp-for="Input.CardNumber"
                           class="form-control card-number-input"
                           autocomplete="cc-number"
                           inputmode="numeric"
                           maxlength="19"
                           pattern="[0-9]{4} [0-9]{4} [0-9]{4} [0-9]{4}"
                           aria-describedby="cardNumberHint"
                           placeholder="4111 1111 1111 1111" />
                    <span class="card-group-guide" aria-hidden="true">
                        <i>4</i><i>4</i><i>4</i><i>4</i>
                    </span>
                </div>
                <small id="cardNumberHint" class="field-hint">16 digits, automatically separated into four groups.</small>
                <span asp-validation-for="Input.CardNumber" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.ExpiryMonth" class="form-label"></label>
                <input asp-for="Input.ExpiryMonth"
                       class="form-control"
                       min="1"
                       max="12"
                       autocomplete="cc-exp-month" />
                <span asp-validation-for="Input.ExpiryMonth" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.ExpiryYear" class="form-label"></label>
                <input asp-for="Input.ExpiryYear"
                       class="form-control"
                       min="2026"
                       max="2100"
                       autocomplete="cc-exp-year" />
                <span asp-validation-for="Input.ExpiryYear" class="text-danger"></span>
            </div>
            <div class="col-md-4">
                <label asp-for="Input.Cvv" class="form-label"></label>
                <input asp-for="Input.Cvv"
                       class="form-control"
                       maxlength="3"
                       inputmode="numeric"
                       autocomplete="cc-csc"
                       placeholder="123" />
                <span asp-validation-for="Input.Cvv" class="text-danger"></span>
            </div>
        </div>

        <button type="submit" class="btn checkout-pay-button w-100 mt-4">
            <span>Pay <span id="partnerPayTotal">LKR @((unitPrice * Model.Input.Quantity).ToString("N2"))</span></span>
            <small>Confirm @Model.Input.Quantity ticket(s)</small>
        </button>
    </form>

    <aside class="partner-order-summary checkout-order-summary">
        <span>Order summary</span>
        <h2>@Model.EventItem.Title</h2>
        <dl>
            <div>
                <dt>Schedule</dt>
                <dd>
                    @Model.EventItem.EventDate.ToString("dd MMM yyyy")
                    @if (Model.EventItem.EndDate.Date != Model.EventItem.EventDate.Date)
                    {
                        <text> – @Model.EventItem.EndDate.ToString("dd MMM yyyy")</text>
                    }
                </dd>
            </div>
            <div><dt>Venue</dt><dd>@Model.EventItem.Venue</dd></div>
            <div><dt>Ticket</dt><dd>@(selectedTier?.Name ?? "Selected ticket")</dd></div>
            <div><dt>Quantity</dt><dd id="partnerSummaryQuantity">@Model.Input.Quantity</dd></div>
            <div><dt>Unit price</dt><dd>LKR @unitPrice.ToString("N2")</dd></div>
            <div><dt>Total payment</dt><dd id="partnerSummaryTotal">LKR @((unitPrice * Model.Input.Quantity).ToString("N2"))</dd></div>
        </dl>
        <div class="checkout-sync-message">
            <strong>Live inventory protected</strong>
            <p>Successful payment updates the organizer's shared ticket stock immediately.</p>
        </div>
    </aside>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        (() => {
            const form = document.querySelector('.checkout-form-card');
            const quantityInput = document.getElementById('Input_Quantity');
            const summaryQuantity = document.getElementById('partnerSummaryQuantity');
            const summaryTotal = document.getElementById('partnerSummaryTotal');
            const payTotal = document.getElementById('partnerPayTotal');
            const confirmationText = document.querySelector('.checkout-pay-button small');
            const cardNumberInput = document.getElementById('Input_CardNumber');
            const unitPrice = Number(form?.dataset.unitPrice ?? 0);
            const maximumQuantity = Math.max(1, Number(form?.dataset.maximumQuantity ?? 1));

            const formatMoney = value => `LKR ${value.toLocaleString('en-LK', {
                minimumFractionDigits: 2,
                maximumFractionDigits: 2
            })}`;

            const updateSummary = () => {
                let quantity = Number(quantityInput?.value ?? 1);
                quantity = Math.max(1, Math.min(maximumQuantity, Number.isFinite(quantity) ? quantity : 1));

                if (quantityInput) quantityInput.value = quantity;
                if (summaryQuantity) summaryQuantity.textContent = quantity.toString();
                if (summaryTotal) summaryTotal.textContent = formatMoney(unitPrice * quantity);
                if (payTotal) payTotal.textContent = formatMoney(unitPrice * quantity);
                if (confirmationText) confirmationText.textContent = `Confirm ${quantity} ticket(s)`;
            };

            document.querySelectorAll('[data-quantity-action]').forEach(button => {
                button.addEventListener('click', () => {
                    if (!quantityInput) return;
                    const delta = button.dataset.quantityAction === 'increase' ? 1 : -1;
                    quantityInput.value = Number(quantityInput.value || 1) + delta;
                    updateSummary();
                });
            });

            const formatCardNumber = () => {
                if (!cardNumberInput) return;
                const digits = cardNumberInput.value.replace(/\D/g, '').slice(0, 16);
                cardNumberInput.value = digits.replace(/(.{4})/g, '$1 ').trim();
                cardNumberInput.setCustomValidity(
                    digits.length === 0 || digits.length === 16
                        ? ''
                        : 'Enter exactly 16 card digits.');
            };

            quantityInput?.addEventListener('input', updateSummary);
            cardNumberInput?.addEventListener('input', formatCardNumber);
            cardNumberInput?.addEventListener('blur', formatCardNumber);
            form?.addEventListener('submit', formatCardNumber);
            updateSummary();
            formatCardNumber();
        })();
    </script>
}
