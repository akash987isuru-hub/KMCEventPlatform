@page
@model KMC.Web.Pages.Account.RegisterModel
@{ ViewData["Title"] = "Create Account"; }
<section class="auth-page"><div class="container"><div class="auth-shell reveal-on-scroll">
<div class="auth-visual"><div><a class="kmc-brand" asp-page="/Index"><span class="brand-mark">K</span><span class="brand-copy"><strong>KMC Events</strong><small>Kandy Municipal Council</small></span></a><span class="eyebrow-pill mt-5"><span class="eyebrow-dot"></span>Join Kandy's event community</span><h2>Choose how you connect.</h2><p>Register as a public user to buy tickets, or use your organizer company name to manage events and connect a matching personal event website.</p></div>
<div class="auth-benefits"><div class="auth-benefit"><span>1</span>Public users discover events and manage tickets</div><div class="auth-benefit"><span>2</span>Organizer companies publish and monitor events</div><div class="auth-benefit"><span>3</span>Matching company names connect partner website events</div></div></div>
<div class="auth-form-panel"><div class="auth-form-inner"><span class="section-kicker">Get started</span><h1>Create your account</h1><p class="text-muted mb-4">Select the account type first. The name field changes automatically.</p>
<form asp-page="/Account/Register" method="post"><div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<div class="mb-3"><label asp-for="Input.Role" class="form-label">Account type</label><select asp-for="Input.Role" class="form-select form-select-lg" id="accountType"><option value="">Select account type</option><option value="Participant">Public User — discover and purchase tickets</option><option value="Organizer">Organizer Company — create and manage events</option></select><span asp-validation-for="Input.Role" class="text-danger small"></span></div>
<div class="mb-3"><label asp-for="Input.FullName" class="form-label" id="nameLabel">Full Name</label><input asp-for="Input.FullName" class="form-control" id="nameInput" placeholder="Enter your full name" autocomplete="name" /><span asp-validation-for="Input.FullName" class="text-danger small"></span><div class="form-text" id="nameHelp">Public users should enter their personal full name.</div></div>
<div class="mb-3"><label asp-for="Input.Email" class="form-label"></label><input asp-for="Input.Email" class="form-control" placeholder="name@example.com" autocomplete="email" /><span asp-validation-for="Input.Email" class="text-danger small"></span></div>
<div class="row g-3"><div class="col-md-6"><label asp-for="Input.Password" class="form-label"></label><input asp-for="Input.Password" class="form-control" placeholder="At least 8 characters" autocomplete="new-password" /><div class="form-text">Use uppercase, lowercase and a number.</div><span asp-validation-for="Input.Password" class="text-danger small"></span></div><div class="col-md-6"><label asp-for="Input.ConfirmPassword" class="form-label"></label><input asp-for="Input.ConfirmPassword" class="form-control" placeholder="Repeat password" autocomplete="new-password" /><span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span></div></div>
<button type="submit" class="btn btn-dark btn-lg w-100 mt-4">Create KMC Account</button></form><p class="auth-switch mt-4 mb-0">Already registered? <a asp-page="/Account/Login" class="fw-bold">Sign in</a></p></div></div>
</div></div></section>
@section Scripts { <partial name="_ValidationScriptsPartial" />
<script>
(() => {
 const type = document.getElementById('accountType'); const label = document.getElementById('nameLabel'); const input = document.getElementById('nameInput'); const help = document.getElementById('nameHelp');
 const update = () => { const organizer = type?.value === 'Organizer'; label.textContent = organizer ? 'Organizer Company Name' : 'Full Name'; input.placeholder = organizer ? 'Example: Sparkling Events Kandy' : 'Enter your full name'; help.textContent = organizer ? 'Use the exact company name used by your personal organizer website so its events appear in your workspace.' : 'Public users should enter their personal full name.'; };
 type?.addEventListener('change', update); update();
})();
</script> }
