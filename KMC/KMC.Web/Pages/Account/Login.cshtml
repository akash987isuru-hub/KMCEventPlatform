@page
@model KMC.Web.Pages.Account.LoginModel

@{
    ViewData["Title"] = "Sign In";
}

<section class="auth-page">
    <div class="container">
        <div class="auth-shell reveal-on-scroll">
            <div class="auth-visual">
                <div>
                    <a class="kmc-brand"
                       asp-page="/Index">
                        <span class="brand-mark" aria-hidden="true">K</span>
                        <span class="brand-copy">
                            <strong>KMC Events</strong>
                            <small>Kandy Municipal Council</small>
                        </span>
                    </a>

                    <span class="eyebrow-pill mt-5">
                        <span class="eyebrow-dot"></span>
                        Welcome back
                    </span>

                    <h2>Continue your Kandy event journey.</h2>
                    <p>
                        Sign in to register for city events or open your organizer
                        workspace and manage your published experiences.
                    </p>
                </div>

                <div class="auth-benefits">
                    <div class="auth-benefit">
                        <span>✓</span>
                        Secure JWT and cookie-based authentication
                    </div>
                    <div class="auth-benefit">
                        <span>✓</span>
                        Personalized public user and organizer access
                    </div>
                    <div class="auth-benefit">
                        <span>✓</span>
                        One connected municipal event platform
                    </div>
                </div>
            </div>

            <div class="auth-form-panel">
                <div class="auth-form-inner">
                    <span class="section-kicker">Account access</span>
                    <h1>Sign in</h1>
                    <p class="text-muted mb-4">
                        Enter your registered email address and password.
                    </p>

                    @if (TempData["SuccessMessage"] is string message)
                    {
                        <div class="alert alert-success">
                            @message
                        </div>
                    }

                    <form asp-page="/Account/Login" method="post">
                        <input asp-for="Input.ReturnUrl" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="alert alert-danger">
                        </div>

                        <div class="mb-3">
                            <label asp-for="Input.Email" class="form-label"></label>
                            <input asp-for="Input.Email"
                                   class="form-control"
                                   placeholder="name@example.com"
                                   autocomplete="email" />
                            <span asp-validation-for="Input.Email"
                                  class="text-danger small">
                            </span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Input.Password" class="form-label"></label>
                            <input asp-for="Input.Password"
                                   class="form-control"
                                   placeholder="Enter your password"
                                   autocomplete="current-password" />
                            <span asp-validation-for="Input.Password"
                                  class="text-danger small">
                            </span>
                        </div>

                        <button type="submit"
                                class="btn btn-dark btn-lg w-100">
                            Sign In to KMC Events
                        </button>
                    </form>

                    <p class="auth-switch mt-4 mb-0">
                        New to the platform?
                        <a asp-page="/Account/Register" class="fw-bold">
                            Create an account
                        </a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
