@page
@model KMC.Web.Pages.Participant.HomeModel

@{
    ViewData["Title"] = "Public User Home";

    var displayName = User.Identity?.Name ?? "Public User";
    var upcomingTickets = Model.Registrations
        .Where(registration =>
            string.Equals(registration.Status, "Confirmed", StringComparison.OrdinalIgnoreCase) &&
            registration.EventDate.Date.Add(registration.StartTime) > DateTime.Now)
        .OrderBy(registration => registration.EventDate)
        .ThenBy(registration => registration.StartTime)
        .Take(3)
        .ToList();

    var nextTicket = upcomingTickets.FirstOrDefault();
}

<section class="role-home-hero participant-role-home">
    <div class="role-home-orb role-home-orb-one" aria-hidden="true"></div>
    <div class="role-home-orb role-home-orb-two" aria-hidden="true"></div>

    <div class="container position-relative">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <span class="eyebrow-pill">
                    <span class="eyebrow-dot"></span>
                    Public User Home
                </span>

                <h1>
                    Welcome, @displayName.<br />
                    <span>Your next Kandy experience begins here.</span>
                </h1>

                <p class="role-home-lead">
                    Discover trusted events, choose the ticket experience that suits you,
                    complete a secure payment, and keep every active ticket in one place.
                </p>

                <div class="role-home-actions">
                    <a asp-page="/Events/Index"
                       class="btn btn-kmc-gold btn-lg">
                        Explore Events
                    </a>
                    <a asp-page="/Participant/Index"
                       class="btn btn-hero-outline btn-lg">
                        Open Dashboard
                    </a>
                </div>

                <div class="role-home-trust">
                    <span><strong>01</strong> Discover verified city events</span>
                    <span><strong>02</strong> Select a ticket category</span>
                    <span><strong>03</strong> Download your ticket and receipt</span>
                </div>
            </div>

            <div class="col-lg-5">
                <aside class="role-command-card reveal-on-scroll">
                    <div class="command-card-head">
                        <div>
                            <span>Personal overview</span>
                            <h2>Your event journey</h2>
                        </div>
                        <span class="command-live"><i></i> Ready</span>
                    </div>

                    <div class="command-metric-grid">
                        <div>
                            <span>Active tickets</span>
                            <strong>@Model.TotalTickets</strong>
                        </div>
                        <div>
                            <span>Confirmed</span>
                            <strong>@Model.ConfirmedTickets</strong>
                        </div>
                        <div>
                            <span>Upcoming</span>
                            <strong>@Model.UpcomingEvents</strong>
                        </div>
                        <div>
                            <span>Payments</span>
                            <strong class="command-money">LKR @Model.TotalPaid.ToString("N0")</strong>
                        </div>
                    </div>

                    @if (nextTicket is not null)
                    {
                        <div class="command-next-event">
                            <span>Your next event</span>
                            <strong>@nextTicket.EventTitle</strong>
                            <small>
                                @nextTicket.EventDate.ToString("dd MMM yyyy") ·
                                @nextTicket.StartTime.ToString(@"hh\:mm") ·
                                @nextTicket.TicketTierName ticket
                            </small>
                        </div>
                    }
                    else
                    {
                        <div class="command-next-event">
                            <span>Your next action</span>
                            <strong>Find an experience to remember</strong>
                            <small>Explore published events and select the ticket category that suits you.</small>
                        </div>
                    }
                </aside>
            </div>
        </div>
    </div>
</section>

<section class="professional-section">
    <div class="container">
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger modern-alert">@Model.ErrorMessage</div>
        }

        <div class="professional-section-heading reveal-on-scroll">
            <div>
                <span class="section-kicker">Simple and secure</span>
                <h2>A clear journey from discovery to entry</h2>
                <p>The public user experience keeps every important step easy to understand and manage.</p>
            </div>
            <a asp-page="/Registrations/Index"
               class="btn btn-outline-dark">
                View My Tickets
            </a>
        </div>

        <div class="row g-4 role-feature-grid">
            <div class="col-md-4">
                <article class="role-feature-card reveal-on-scroll">
                    <span class="role-feature-index">01</span>
                    <h3>Explore with confidence</h3>
                    <p>Review the date, venue, organizer, availability and ticket options before making a decision.</p>
                    <a asp-page="/Events/Index">Browse events →</a>
                </article>
            </div>
            <div class="col-md-4">
                <article class="role-feature-card reveal-on-scroll">
                    <span class="role-feature-index">02</span>
                    <h3>Choose your experience</h3>
                    <p>Select Standard, Premium or VIP access according to the price and capacity configured by the organizer.</p>
                    <a asp-page="/Events/Index">Compare ticket options →</a>
                </article>
            </div>
            <div class="col-md-4">
                <article class="role-feature-card reveal-on-scroll">
                    <span class="role-feature-index">03</span>
                    <h3>Keep tickets organised</h3>
                    <p>Access active registrations, payment references, downloadable tickets and receipts from your personal area.</p>
                    <a asp-page="/Registrations/Index">Manage tickets →</a>
                </article>
            </div>
        </div>
    </div>
</section>

<section class="professional-section professional-section-soft">
    <div class="container">
        <div class="professional-section-heading reveal-on-scroll">
            <div>
                <span class="section-kicker">Recommended for you</span>
                <h2>Explore upcoming Kandy experiences</h2>
                <p>Published events you have not already booked, ordered by the nearest event date.</p>
            </div>
            <a asp-page="/Events/Index"
               class="btn btn-outline-dark">
                View All Events
            </a>
        </div>

        @if (Model.RecommendedEvents.Count == 0)
        {
            <div class="empty-state-card professional-empty reveal-on-scroll">
                <span class="empty-state-symbol">K</span>
                <h3>No new recommendations available</h3>
                <p>More published events will appear here as organizers add new experiences.</p>
                <a asp-page="/Participant/Index" class="btn btn-kmc-gold">
                    Open Dashboard
                </a>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var eventItem in Model.RecommendedEvents.Take(3))
                {
                    var available = Math.Max(0, eventItem.Capacity - eventItem.RegisteredParticipantCount);

                    <div class="col-md-6 col-xl-4">
                        <article class="portfolio-event-card participant-portfolio-card reveal-on-scroll">
                            <div class="portfolio-event-top">
                                <span>@eventItem.EventType</span>
                                <strong>@eventItem.EventDate.ToString("dd")</strong>
                                <small>@eventItem.EventDate.ToString("MMM yyyy")</small>
                            </div>
                            <div class="portfolio-event-body">
                                <h3>@eventItem.Title</h3>
                                <p>@eventItem.Venue · @eventItem.Location</p>
                                <div class="portfolio-event-metrics">
                                    <span><strong>LKR @eventItem.MinimumTicketPrice.ToString("N0")</strong> from</span>
                                    <span><strong>@available</strong> available</span>
                                </div>
                                <a asp-page="/Events/Details"
                                   asp-route-id="@eventItem.Id"
                                   class="btn btn-kmc-gold btn-sm mt-4">
                                    View Tickets
                                </a>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>
