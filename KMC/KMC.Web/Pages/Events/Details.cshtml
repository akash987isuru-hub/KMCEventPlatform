@page
@model KMC.Web.Pages.Events.DetailsModel
@{
    ViewData["Title"] = Model.Title;
    var isParticipant = User.Identity?.IsAuthenticated == true && User.IsInRole("Participant");
    var switchAccount = User.Identity?.IsAuthenticated == true && !isParticipant;
}

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="container py-5"><div class="alert alert-danger">@Model.ErrorMessage</div></div>
}
else
{
<section class="page-hero event-detail-hero">
    <div class="container">
        <span class="eyebrow-pill"><span class="eyebrow-dot"></span>@Model.EventType</span>
        <div class="page-hero-row">
            <div><h1>@Model.Title</h1><p>@Model.Description</p><p class="mb-0">Organized by <strong>@Model.OrganizerName</strong></p></div>
            <div class="page-hero-stat"
                 id="eventAvailabilityStat"
                 data-ended="@Model.Event.HasEnded.ToString().ToLowerInvariant()">
                @if (Model.Event.HasEnded)
                {
                    <strong id="eventAvailableTicketCount">Ended</strong>
                    <span id="eventAvailabilityLabel">This event has finished</span>
                }
                else if (Model.AvailableTicketCount <= 0)
                {
                    <strong id="eventAvailableTicketCount">Sold Out</strong>
                    <span id="eventAvailabilityLabel">No tickets remaining</span>
                }
                else
                {
                    <strong id="eventAvailableTicketCount">@Model.AvailableTicketCount</strong>
                    <span id="eventAvailabilityLabel">ticket(s) available</span>
                }
            </div>
        </div>
    </div>
</section>
<div class="container py-5">
    <div class="row g-4">
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm h-100"><div class="card-body p-4 p-lg-5">
                <span class="section-kicker">Event information</span><h2 class="h3 fw-bold">Plan your visit</h2>
                <div class="event-detail-list mt-4">
                    <div><span>Date</span><strong>@Model.EventDate.ToString("dddd, dd MMMM yyyy")@(Model.EndDate.Date != Model.EventDate.Date ? $" – {Model.EndDate:dddd, dd MMMM yyyy}" : "")</strong></div>
                    <div><span>Time</span><strong>@Model.StartTime.ToString(@"hh\:mm") – @Model.EndTime.ToString(@"hh\:mm")</strong></div>
                    <div><span>Venue</span><strong>@Model.Venue</strong></div><div><span>Location</span><strong>@Model.Location</strong></div>
                    <div><span>Organizer</span><strong>@Model.OrganizerName</strong></div><div><span>Tickets sold</span><strong>@Model.RegisteredParticipantCount / @Model.Capacity</strong></div>
                </div>
            </div></div>
        </div>
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm h-100 ticket-selection-card"><div class="card-body p-4 p-lg-5">
                <span class="section-kicker">Ticket selection</span><h2 class="h3 fw-bold mb-2">Choose your experience</h2>
                @if (Model.Event.HasEnded) { <div class="alert alert-secondary">This event has ended. Ticket sales are closed.</div> }
                else if (Model.Event.IsSoldOut) { <div class="alert alert-danger">All ticket categories are sold out.</div> }
                else if (Model.TicketTiers.Count == 0) { <div class="alert alert-warning">Ticket categories have not been configured.</div> }
                else
                {
                    <div class="ticket-choice-list">
                    @foreach (var ticket in Model.TicketTiers.OrderBy(t => t.SortOrder))
                    {
                        var soldOut = ticket.RemainingCount <= 0;
                        <article class="ticket-choice @(soldOut ? "ticket-choice-sold" : string.Empty)"><div><span class="ticket-choice-name">@ticket.Name</span><strong>LKR @ticket.Price.ToString("N2")</strong><small>@ticket.RemainingCount of @ticket.Capacity available</small></div>
                        @if (soldOut)
                        {
                            <span class="badge bg-danger">Sold Out</span>
                        }
                        else if (isParticipant)
                        {
                            <a asp-page="/Checkout/Index"
                               asp-route-eventId="@Model.Id"
                               asp-route-ticketTierId="@ticket.Id"
                               class="btn btn-kmc-gold btn-sm">Buy Tickets</a>
                        }
                        else
                        {
                            var checkoutUrl = Url.Page(
                                "/Checkout/Index",
                                new { eventId = Model.Id, ticketTierId = ticket.Id }) ??
                                Url.Page("/Events/Details", new { id = Model.Id }) ??
                                "/Events";

                            <a asp-page="/Account/Login"
                               asp-route-returnUrl="@checkoutUrl"
                               asp-route-switchAccount="@switchAccount"
                               class="btn btn-outline-dark btn-sm">Sign in</a>
                        }
                        </article>
                    }
                    </div>
                }
            </div></div>
        </div>
    </div>
</div>
}

@section Scripts {
    <script>
        (() => {
            const statElement = document.getElementById('eventAvailabilityStat');
            const countElement = document.getElementById('eventAvailableTicketCount');
            const labelElement = document.getElementById('eventAvailabilityLabel');

            if (!statElement || !countElement || !labelElement) return;
            if (statElement.dataset.ended === 'true') return;

            const endpoint = new URL(window.location.href);
            endpoint.searchParams.set('handler', 'Availability');

            const refreshAvailability = async () => {
                try {
                    const response = await fetch(endpoint, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        cache: 'no-store'
                    });

                    if (!response.ok) return;

                    const data = await response.json();

                    if (data.hasEnded === true) {
                        countElement.textContent = 'Ended';
                        labelElement.textContent = 'This event has finished';
                        return;
                    }

                    if (data.isSoldOut === true || data.availableCount <= 0) {
                        countElement.textContent = 'Sold Out';
                        labelElement.textContent = 'No tickets remaining';
                        return;
                    }

                    if (Number.isInteger(data.availableCount)) {
                        countElement.textContent = data.availableCount.toString();
                        labelElement.textContent = 'ticket(s) available';
                    }
                } catch {
                    // Keep the last successfully loaded availability value.
                }
            };

            refreshAvailability();
            window.setInterval(refreshAvailability, 5000);
        })();
    </script>
}
