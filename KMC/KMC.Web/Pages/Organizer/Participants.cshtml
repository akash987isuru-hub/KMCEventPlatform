@page
@model KMC.Web.Pages.Organizer.ParticipantsModel

@{
    ViewData["Title"] = "Ticket Sales and Public Users";
    var eventTitle = Model.EventTitle;
    var eventId = Model.EventId;
    var confirmed = Model.Participants
        .Where(item => string.Equals(
            item.Status,
            "Confirmed",
            StringComparison.OrdinalIgnoreCase))
        .Sum(item => Math.Max(1, item.Quantity));
    var revenue = Model.Participants
        .Where(item => string.Equals(item.PaymentStatus, "Approved", StringComparison.OrdinalIgnoreCase))
        .Sum(item => item.TotalAmount);
}

<div class="container py-5">
    <div class="mb-4">
        <a asp-page="/Organizer/Index"
           class="text-decoration-none text-secondary">
            ← Back to Organizer Workspace
        </a>
    </div>

    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-end gap-3 mb-4">
        <div>
            <span class="badge bg-warning text-dark mb-2">Organizer Interface</span>
            <h1 class="display-6 fw-bold mb-1">Ticket Sales & Public Users</h1>
            <p class="text-muted mb-0">@eventTitle</p>
        </div>
        <a asp-page="/Organizer/Edit"
           asp-route-id="@eventId"
           class="btn btn-outline-dark">
            Edit Event Tickets
        </a>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="dashboard-stat-card">
                <span>All records</span>
                <strong>@Model.Participants.Count</strong>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-stat-card">
                <span>Confirmed tickets</span>
                <strong>@confirmed</strong>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-stat-card">
                <span>Approved ticket revenue</span>
                <strong class="dashboard-money">LKR @revenue.ToString("N2")</strong>
            </div>
        </div>
    </div>

    @if (Model.Participants.Count == 0)
    {
        <div class="empty-state-card">
            <h2 class="h4 fw-bold">No ticket purchases yet</h2>
            <p>Public users will appear here after completing the ticket checkout.</p>
        </div>
    }
    else
    {
        <div class="card border-0 shadow-sm overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Public User</th>
                            <th>Ticket</th>
                            <th>Quantity & Total</th>
                            <th>Payment</th>
                            <th>Reference</th>
                            <th>Registered</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var participant in Model.Participants)
                        {
                            <tr>
                                <td>
                                    <strong class="d-block">@participant.ParticipantName</strong>
                                    <small class="text-muted">@participant.ParticipantEmail</small>
                                </td>
                                <td>
                                    <span class="badge bg-warning text-dark">@participant.TicketTierName</span>
                                    <small class="d-block mt-1">LKR @participant.TicketPrice.ToString("N2") each</small>
                                </td>
                                <td>
                                    <strong>@participant.Quantity ticket(s)</strong>
                                    <small class="d-block mt-1">LKR @participant.TotalAmount.ToString("N2")</small>
                                </td>
                                <td>
                                    <span class="badge @(participant.PaymentStatus == "Approved" ? "bg-success" : "bg-secondary")">
                                        @participant.PaymentStatus
                                    </span>
                                </td>
                                <td class="transaction-reference">
                                    @(string.IsNullOrWhiteSpace(participant.TransactionReference)
                                        ? "Legacy record"
                                        : participant.TransactionReference)
                                </td>
                                <td>@participant.RegisteredAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</td>
                                <td>
                                    <span class="badge @(participant.Status == "Confirmed" ? "bg-success" : "bg-secondary")">
                                        @participant.Status
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
