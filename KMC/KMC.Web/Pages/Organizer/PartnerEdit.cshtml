@page
@model KMC.Web.Pages.Organizer.PartnerEditModel

@{
    ViewData["Title"] = "Edit Connected Event";
}

<section class="management-page-shell">
    <div class="container py-5">
        <a asp-page="/Organizer/Index" class="management-back-link">
            <span aria-hidden="true">←</span> Back to Organizer Workspace
        </a>

        <div class="management-form-card mt-4">
            <div class="management-form-header">
                <div>
                    <span class="eyebrow-pill"><span class="eyebrow-dot"></span> Connected Event</span>
                    <h1>Edit event and ticket categories</h1>
                    <p>
                        Changes made here are sent to the organizer website and synchronized back to the KMC platform.
                    </p>
                </div>
                <span class="management-source-chip">Two-way management</span>
            </div>

            <form asp-page="/Organizer/PartnerEdit"
                  asp-route-id="@Model.Input.Id"
                  method="post"
                  class="management-form-body">
                <input asp-for="Input.Id" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row g-4">
                    <div class="col-12">
                        <label asp-for="Input.Title" class="form-label"></label>
                        <input asp-for="Input.Title" class="form-control" placeholder="Enter the event title" />
                        <span asp-validation-for="Input.Title" class="text-danger"></span>
                    </div>

                    <div class="col-12">
                        <label asp-for="Input.Description" class="form-label"></label>
                        <textarea asp-for="Input.Description" class="form-control" rows="5" placeholder="Describe the event"></textarea>
                        <span asp-validation-for="Input.Description" class="text-danger"></span>
                    </div>

                    <div class="col-md-7">
                        <label asp-for="Input.EventType" class="form-label"></label>
                        <input asp-for="Input.EventType" class="form-control" placeholder="Music, Sports, Education..." />
                        <span asp-validation-for="Input.EventType" class="text-danger"></span>
                    </div>

                    <div class="col-md-5">
                        <label asp-for="Input.IsPublished" class="form-label"></label>
                        <select asp-for="Input.IsPublished" class="form-select">
                            <option value="true">Published</option>
                            <option value="false">Draft</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label asp-for="Input.EventDate" class="form-label"></label>
                        <input asp-for="Input.EventDate" type="date" class="form-control" />
                        <span asp-validation-for="Input.EventDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.StartTime" class="form-label"></label>
                        <input asp-for="Input.StartTime" type="time" class="form-control" />
                        <span asp-validation-for="Input.StartTime" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.EndDate" class="form-label"></label>
                        <input asp-for="Input.EndDate" type="date" class="form-control" />
                        <span asp-validation-for="Input.EndDate" class="text-danger"></span>
                    </div>
                    <div class="col-md-3">
                        <label asp-for="Input.EndTime" class="form-label"></label>
                        <input asp-for="Input.EndTime" type="time" class="form-control" />
                        <span asp-validation-for="Input.EndTime" class="text-danger"></span>
                    </div>

                    <div class="col-md-6">
                        <label asp-for="Input.Venue" class="form-label"></label>
                        <input asp-for="Input.Venue" class="form-control" placeholder="Venue name" />
                        <span asp-validation-for="Input.Venue" class="text-danger"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="Input.Location" class="form-label"></label>
                        <input asp-for="Input.Location" class="form-control" placeholder="City or area" />
                        <span asp-validation-for="Input.Location" class="text-danger"></span>
                    </div>
                </div>

                <section class="management-ticket-section">
                    <div class="management-ticket-heading">
                        <div>
                            <span class="section-kicker">Ticket inventory</span>
                            <h2>Ticket categories</h2>
                        </div>
                        <span class="ticket-total-chip">
                            <strong id="connectedTotalCapacity">@Model.Input.TicketTiers.Sum(item => item.Capacity)</strong>
                            total capacity
                        </span>
                    </div>

                    <span asp-validation-for="Input.TicketTiers" class="text-danger d-block mb-3"></span>

                    <div class="row g-3">
                        @for (var index = 0; index < Model.Input.TicketTiers.Count; index++)
                        {
                            <div class="col-lg-4">
                                <article class="management-ticket-card">
                                    <input asp-for="Input.TicketTiers[index].ExternalTicketTierId" type="hidden" />
                                    <input asp-for="Input.TicketTiers[index].SoldCount" type="hidden" />
                                    <input asp-for="Input.TicketTiers[index].SortOrder" type="hidden" />

                                    <div class="management-ticket-card-head">
                                        <span>Category @(index + 1)</span>
                                        <strong>@Model.Input.TicketTiers[index].SoldCount sold</strong>
                                    </div>

                                    <div class="mb-3">
                                        <label asp-for="Input.TicketTiers[index].Name" class="form-label"></label>
                                        <input asp-for="Input.TicketTiers[index].Name" class="form-control" />
                                        <span asp-validation-for="Input.TicketTiers[index].Name" class="text-danger"></span>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="Input.TicketTiers[index].Description" class="form-label"></label>
                                        <input asp-for="Input.TicketTiers[index].Description" class="form-control" placeholder="Optional ticket benefit" />
                                        <span asp-validation-for="Input.TicketTiers[index].Description" class="text-danger"></span>
                                    </div>
                                    <div class="row g-3">
                                        <div class="col-6">
                                            <label asp-for="Input.TicketTiers[index].Price" class="form-label"></label>
                                            <div class="input-group">
                                                <span class="input-group-text">LKR</span>
                                                <input asp-for="Input.TicketTiers[index].Price" class="form-control" min="0" step="0.01" />
                                            </div>
                                            <span asp-validation-for="Input.TicketTiers[index].Price" class="text-danger"></span>
                                        </div>
                                        <div class="col-6">
                                            <label asp-for="Input.TicketTiers[index].Capacity" class="form-label"></label>
                                            <input asp-for="Input.TicketTiers[index].Capacity"
                                                   class="form-control connected-capacity-input"
                                                   min="@Math.Max(1, Model.Input.TicketTiers[index].SoldCount)" />
                                            <span asp-validation-for="Input.TicketTiers[index].Capacity" class="text-danger"></span>
                                        </div>
                                    </div>
                                </article>
                            </div>
                        }
                    </div>
                </section>

                <div class="management-form-actions">
                    <button type="submit" class="btn btn-kmc-gold px-4">Save Connected Event</button>
                    <a asp-page="/Organizer/Index" class="btn btn-outline-secondary">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const connectedCapacityInputs = document.querySelectorAll('.connected-capacity-input');
        const connectedTotalCapacity = document.getElementById('connectedTotalCapacity');

        function refreshConnectedCapacity() {
            connectedTotalCapacity.textContent = [...connectedCapacityInputs]
                .reduce((total, input) => total + (parseInt(input.value || '0', 10) || 0), 0);
        }

        connectedCapacityInputs.forEach(input => input.addEventListener('input', refreshConnectedCapacity));
    </script>
}
