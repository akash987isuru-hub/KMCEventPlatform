@page
@model KMC.Web.Pages.IndexModel

@{
    ViewData["Title"] = "Kandy City Events";

    var isOrganizer = User.Identity?.IsAuthenticated == true &&
                      User.IsInRole("Organizer");

    var isParticipant = User.Identity?.IsAuthenticated == true &&
                        User.IsInRole("Participant");

    var displayName = User.Identity?.Name ?? "there";
}

<section class="home-hero">
    <div class="hero-orb hero-orb-one"></div>
    <div class="hero-orb hero-orb-two"></div>

    <div class="container position-relative">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="hero-copy reveal-on-scroll">
                    <span class="eyebrow-pill">
                        <span class="eyebrow-dot"></span>
                        Kandy Municipal Council
                    </span>

                    @if (isOrganizer)
                    {
                        <h1>
                            Welcome back,
                            <span>@displayName.</span>
                            Bring Kandy together.
                        </h1>

                        <p class="hero-lead">
                            Plan, publish and manage city events from one trusted
                            organizer workspace. Keep event information clear and
                            public users connected.
                        </p>

                        <div class="hero-actions">
                            <a class="btn btn-kmc-gold btn-lg"
                               asp-page="/Organizer/Home">
                                Open Organizer Home
                            </a>

                            <a class="btn btn-hero-outline btn-lg"
                               asp-page="/Organizer/Create">
                                Create New Event
                            </a>
                        </div>
                    }
                    else if (isParticipant)
                    {
                        <h1>
                            Welcome back,
                            <span>@displayName.</span>
                            Your next Kandy experience starts here.
                        </h1>

                        <p class="hero-lead">
                            Discover cultural, educational and community events,
                            choose a ticket category, complete the secure checkout and manage every ticket from your public user dashboard.
                        </p>

                        <div class="hero-actions">
                            <a class="btn btn-kmc-gold btn-lg"
                               asp-page="/Participant/Home">
                                Open Public User Home
                            </a>

                            <a class="btn btn-hero-outline btn-lg"
                               asp-page="/Events/Index">
                                Browse City Events
                            </a>
                        </div>
                    }
                    else
                    {
                        <h1>
                            Kandy's events,
                            <span>one trusted platform.</span>
                        </h1>

                        <p class="hero-lead">
                            Discover city events, register in moments and help create
                            memorable experiences across Kandy through one secure,
                            modern event platform.
                        </p>

                        <div class="hero-actions">
                            <a class="btn btn-kmc-gold btn-lg"
                               asp-page="/Events/Index">
                                Explore Events
                            </a>

                            <a class="btn btn-hero-outline btn-lg"
                               asp-page="/Account/Register">
                                Join the Platform
                            </a>
                        </div>
                    }

                    <div class="hero-trust-row">
                        <div class="trust-item">
                            <span class="trust-check">✓</span>
                            Verified city events
                        </div>
                        <div class="trust-item">
                            <span class="trust-check">✓</span>
                            Secure role-based access
                        </div>
                        <div class="trust-item">
                            <span class="trust-check">✓</span>
                            Secure ticket checkout
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="hero-showcase reveal-on-scroll">
                    <div class="showcase-topbar">
                        <div>
                            <span class="showcase-label">Live platform overview</span>
                            <h2>Kandy is happening</h2>
                        </div>
                        <span class="live-indicator">
                            <span></span>
                            Live
                        </span>
                    </div>

                    <div class="showcase-stat-grid">
                        <div class="showcase-stat">
                            <span>Published events</span>
                            <strong>@Model.TotalPublishedEvents</strong>
                            <small>Available to explore</small>
                        </div>

                        <div class="showcase-stat showcase-stat-accent">
                            <span>Platform access</span>
                            <strong>24/7</strong>
                            <small>Web and mobile ready</small>
                        </div>
                    </div>

                    <div class="city-card">
                        <div class="city-card-pattern"></div>
                        <div class="city-card-content">
                            <span class="city-card-kicker">Featured destination</span>
                            <h3>Experience the heart of Kandy</h3>
                            <p>
                                Culture, community, learning and entertainment—all
                                connected through one municipal platform.
                            </p>
                        </div>
                    </div>

                    <div class="hero-visual-grid">
                        <figure class="hero-visual-card">
                            <img src="~/images/kmc-hero-stage.svg"
                                 alt="Stylized concert stage and crowd illustration for KMC Events" />
                        </figure>
                        <figure class="hero-visual-card">
                            <img src="~/images/kmc-cultural-night.svg"
                                 alt="Stylized cultural event illustration for KMC Events" />
                        </figure>
                        <figure class="hero-visual-card">
                            <img src="~/images/kmc-ticket-experience.svg"
                                 alt="Stylized secure ticket booking illustration for KMC Events" />
                        </figure>
                    </div>

                    <div class="showcase-footer">
                        <div class="mini-avatars" aria-hidden="true">
                            <span>A</span>
                            <span>K</span>
                            <span>N</span>
                            <span>+</span>
                        </div>
                        <p>
                            Built for public users, organizers and the city community.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-block section-soft">
    <div class="container">
        <div class="section-heading reveal-on-scroll">
            <div>
                <span class="section-kicker">Discover Kandy</span>
                <h2>Upcoming city experiences</h2>
                <p>
                    Explore published events from trusted organizers across the city.
                </p>
            </div>

            <a class="btn btn-outline-dark"
               asp-page="/Events/Index">
                View All Events
            </a>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-warning modern-alert">
                @Model.ErrorMessage
                You can still use the navigation above to continue.
            </div>
        }
        else if (Model.FeaturedEvents.Count == 0)
        {
            <div class="empty-state-card reveal-on-scroll">
                <div class="empty-state-icon">K</div>
                <h3>New events are coming soon</h3>
                <p>
                    Organizers are preparing the next set of experiences for Kandy.
                </p>
                @if (isOrganizer)
                {
                    <a class="btn btn-dark"
                       asp-page="/Organizer/Create">
                        Create the First Event
                    </a>
                }
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var eventItem in Model.FeaturedEvents)
                {
                    var availableSeats = Math.Max(
                        0,
                        eventItem.Capacity - eventItem.RegisteredParticipantCount);

                    var occupancy = eventItem.Capacity > 0
                        ? Math.Clamp(
                            (eventItem.RegisteredParticipantCount * 100) /
                            eventItem.Capacity,
                            0,
                            100)
                        : 0;

                    <div class="col-md-6 col-xl-4">
                        <article class="event-preview-card reveal-on-scroll">
                            <div class="event-preview-visual">
                                <span class="event-type-pill">
                                    @eventItem.EventType
                                </span>
                                <div class="event-date-tile">
                                    <strong>@eventItem.EventDate.ToString("dd")</strong>
                                    <span>@eventItem.EventDate.ToString("MMM")</span>
                                </div>
                                <div class="event-preview-pattern"></div>
                            </div>

                            <div class="event-preview-body">
                                <p class="event-location">
                                    @eventItem.Location · @eventItem.Venue
                                </p>

                                <h3>@eventItem.Title</h3>

                                <p class="event-description">
                                    @(string.IsNullOrWhiteSpace(eventItem.Description)
                                        ? "A city event organized for the Kandy community."
                                        : eventItem.Description)
                                </p>

                                <div class="event-meta-row">
                                    <span>
                                        @eventItem.StartTime.ToString(@"hh\:mm")
                                        –
                                        @eventItem.EndTime.ToString(@"hh\:mm")
                                    </span>
                                    <span>@availableSeats places left</span>
                                </div>

                                <div class="event-capacity-bar" aria-hidden="true">
                                    <span style="width: @occupancy%"></span>
                                </div>

                                <div class="event-card-footer">
                                    <span>By @eventItem.OrganizerName</span>
                                    <a asp-page="/Events/Details"
                                       asp-route-id="@eventItem.Id">
                                        View Event →
                                    </a>
                                </div>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </div>
</section>

<section class="section-block">
    <div class="container">
        <div class="section-heading section-heading-centered reveal-on-scroll">
            <div>
                <span class="section-kicker">One connected service</span>
                <h2>Designed for every part of the event journey</h2>
                <p>
                    A service-oriented platform that keeps discovery, management
                    and registration clear for everyone.
                </p>
            </div>
        </div>

        <div class="row g-4 feature-grid">
            <div class="col-md-4">
                <div class="feature-card reveal-on-scroll">
                    <div class="feature-number">01</div>
                    <div class="feature-icon">⌕</div>
                    <h3>Discover with confidence</h3>
                    <p>
                        Search by event type, date, venue and location to find the
                        right city experience quickly.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card reveal-on-scroll">
                    <div class="feature-number">02</div>
                    <div class="feature-icon">✓</div>
                    <h3>Register and stay organized</h3>
                    <p>
                        Public users can register, review their activity and cancel
                        registrations through a secure personal area.
                    </p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-card reveal-on-scroll">
                    <div class="feature-number">03</div>
                    <div class="feature-icon">◇</div>
                    <h3>Manage events professionally</h3>
                    <p>
                        Organizers can create, publish, update and monitor events
                        while viewing public user information in one workspace.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section-block pt-0">
    <div class="container">
        <div class="role-cta reveal-on-scroll">
            <div class="role-cta-content">
                <span class="section-kicker section-kicker-light">
                    Built for Kandy
                </span>

                @if (isOrganizer)
                {
                    <h2>Ready to create the city's next memorable event?</h2>
                    <p>
                        Open your organizer workspace and publish an experience the
                        community can discover today.
                    </p>
                    <a class="btn btn-kmc-gold btn-lg"
                       asp-page="/Organizer/Create">
                        Create an Event
                    </a>
                }
                else if (isParticipant)
                {
                    <h2>There is always something new to experience in Kandy.</h2>
                    <p>
                        Browse upcoming events and reserve your place through your
                        public user account.
                    </p>
                    <a class="btn btn-kmc-gold btn-lg"
                       asp-page="/Events/Index">
                        Find My Next Event
                    </a>
                }
                else
                {
                    <h2>Join a smarter way to experience city events.</h2>
                    <p>
                        Create a public user or organizer account and become part of
                        Kandy's connected event community.
                    </p>
                    <a class="btn btn-kmc-gold btn-lg"
                       asp-page="/Account/Register">
                        Create Your Account
                    </a>
                }
            </div>

            <div class="role-cta-seal" aria-hidden="true">
                <span>KMC</span>
                <small>EVENTS</small>
            </div>
        </div>
    </div>
</section>
