@page
@model KMC.Web.Pages.PartnerEvents.TicketModel
@{
    ViewData["Title"] = "Partner Ticket";
    var isConfirmed = string.Equals(
        Model.Booking.BookingStatus,
        "Confirmed",
        StringComparison.OrdinalIgnoreCase);
}

<section class="page-hero page-hero-compact ticket-ready-hero">
    <div class="container">
        <span class="eyebrow-pill"><span class="eyebrow-dot"></span>@(isConfirmed ? "Booking confirmed" : "Booking canceled")</span>
        <h1>@(isConfirmed ? "Your partner event ticket is ready." : "This partner event ticket was canceled.")</h1>
        <p>Reference: <strong>@Model.Booking.BookingReference</strong></p>
    </div>
</section>

<div class="container partner-ticket-confirmation">
    @if (TempData["SuccessMessage"] is string success)
    {
        <div class="alert alert-success">@success</div>
    }
    @if (TempData["WarningMessage"] is string warning)
    {
        <div class="alert alert-danger">@warning</div>
    }

    <article class="kmc-partner-ticket" id="printablePartnerTicket">
        <div class="ticket-confirmation-head">
            <span>Connected event ticket</span>
            <strong>@Model.Booking.BookingReference</strong>
        </div>

        <div class="ticket-title-row">
            <div>
                <span class="section-kicker">KMC verified admission</span>
                <h2>@Model.Booking.EventTitle</h2>
                <p>
                    @Model.Booking.EventDate.ToString("dddd, dd MMMM yyyy") ·
                    @Model.Booking.StartTime.ToString(@"hh\:mm") ·
                    @Model.Booking.Venue
                </p>
            </div>
            <span class="ticket-status-pill @(isConfirmed ? "confirmed" : "cancelled")">
                @(isConfirmed ? "Confirmed" : "Canceled")
            </span>
        </div>

        <div class="ticket-confirmation-grid">
            <div><span>Guest</span><strong>@Model.Booking.CustomerName</strong></div>
            <div><span>Ticket</span><strong>@Model.Booking.TicketTierName × @Model.Booking.Quantity</strong></div>
            <div><span>Paid</span><strong>LKR @Model.Booking.TotalAmount.ToString("N2")</strong></div>
            <div><span>Payment</span><strong>@Model.Booking.CardDisplay</strong></div>
            <div><span>Transaction</span><strong>@Model.Booking.TransactionReference</strong></div>
            <div><span>Source</span><strong>@Model.Booking.BookingSource</strong></div>
        </div>

        <div class="ticket-entry-note">
            <span aria-hidden="true">✓</span>
            <p>Present this ticket or the booking reference at the entrance.</p>
        </div>
    </article>

    <div class="ticket-action-bar">
        @if (isConfirmed)
        {
            <button type="button" class="btn btn-kmc-gold" onclick="window.print()">Print Ticket</button>
            <a asp-page-handler="Download"
               asp-route-reference="@Model.Booking.BookingReference"
               class="btn btn-outline-light">Download PDF</a>
            <form method="post"
                  asp-page-handler="Cancel"
                  asp-route-reference="@Model.Booking.BookingReference"
                  onsubmit="return confirm('Cancel this booking and refund the demo payment?');">
                <button type="submit" class="btn btn-outline-danger">Cancel Booking</button>
            </form>
        }
        <a asp-page="/Events/Index" class="btn btn-outline-light">Back to Events</a>
    </div>
</div>
