@page
@model KMC.Web.Pages.Participant.IndexModel

@{
    ViewData["Title"] = "Public User Dashboard";
}

<section class="page-hero page-hero-compact participant-hero">
    <div class="container">
        <span class="eyebrow-pill">
            <span class="eyebrow-dot"></span>
            Public User Dashboard
        </span>
        <div class="page-hero-row">
            <div>
                <h1>Your Event Dashboard</h1>
                <p>
                    Track active tickets, upcoming events and payment activity from one focused public user workspace.
                </p>
            </div>
            <div class="d-flex flex-wrap gap-2">
                <a asp-page="/Events/Index"
                   class="btn btn-kmc-gold">
                    Browse Events
                </a>
                <a asp-page="/Registrations/Index"
                   class="btn btn-outline-dark">
                    My Tickets
                </a>
            </div>
        </div>
    </div>
</section>

<div class="container py-5">
    @if (TempData["RegistrationSuccess"] is string successMessage)
    {
        <div class="alert alert-success">@successMessage</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }

    <div class="row g-4 mb-5">
        <div class="col-sm-6 col-xl-3">
            <div class="dashboard-stat-card">
                <span>Total tickets</span>
                <strong>@Model.TotalTickets</strong>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="dashboard-stat-card">
                <span>Confirmed</span>
                <strong>@Model.ConfirmedTickets</strong>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="dashboard-stat-card">
                <span>Upcoming</span>
                <strong>@Model.UpcomingEvents</strong>
            </div>
        </div>
        <div class="col-sm-6 col-xl-3">
            <div class="dashboard-stat-card">
                <span>Ticket payments</span>
                <strong class="dashboard-money">LKR @Model.TotalPaid.ToString("N0")</strong>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="section-kicker">Your activity</span>
            <h2 class="h3 fw-bold mb-0">Upcoming tickets</h2>
        </div>
        <a asp-page="/Registrations/Index"
           class="btn btn-outline-dark btn-sm">
            View all
        </a>
    </div>

    @{ var upcoming = Model.Registrations
        .Where(registration =>
            string.Equals(registration.Status, "Confirmed", StringComparison.OrdinalIgnoreCase) &&
            registration.EventDate.Date.Add(registration.StartTime) > DateTime.Now)
        .OrderBy(registration => registration.EventDate)
        .Take(3)
        .ToList(); }

    @if (upcoming.Count == 0)
    {
        <div class="empty-state-card mb-5">
            <h3>No upcoming tickets</h3>
            <p>Choose an event and complete the secure checkout to receive your first ticket.</p>
            <a asp-page="/Events/Index" class="btn btn-dark">Explore Events</a>
        </div>
    }
    else
    {
        <div class="row g-4 mb-5">
            @foreach (var registration in upcoming)
            {
                <div class="col-md-6 col-xl-4">
                    <article class="participant-ticket-card h-100">
                        <div class="d-flex justify-content-between gap-2">
                            <span class="badge bg-warning text-dark">@registration.TicketTierName</span>
                            <span class="badge bg-success">@registration.Status</span>
                        </div>
                        <h3 class="h5 fw-bold mt-3">@registration.EventTitle</h3>
                        <p class="text-muted mb-2">
                            @registration.EventDate.ToString("dd MMM yyyy")
                            @if (registration.EndDate.Date != registration.EventDate.Date)
                            {
                                <text> – @registration.EndDate.ToString("dd MMM yyyy")</text>
                            }
                            <text> · @registration.StartTime.ToString(@"hh\:mm") – @registration.EndTime.ToString(@"hh\:mm")</text>
                        </p>
                        <strong class="d-block mb-3">@registration.Quantity ticket(s) · LKR @registration.TotalAmount.ToString("N2")</strong>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-page="/Registrations/PrintTicket"
                               asp-route-registrationId="@registration.Id"
                               target="_blank"
                               rel="noopener"
                               class="btn btn-kmc-gold btn-sm">
                                Print Ticket
                            </a>
                            <a asp-page="/Events/Details"
                               asp-route-id="@registration.EventId"
                               class="btn btn-outline-dark btn-sm">
                                View Event
                            </a>
                        </div>
                    </article>
                </div>
            }
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="section-kicker">Discover more</span>
            <h2 class="h3 fw-bold mb-0">Recommended events</h2>
        </div>
    </div>

    <div class="row g-4">
        @foreach (var eventItem in Model.RecommendedEvents)
        {
            <div class="col-md-6 col-xl-4">
                <article class="event-preview-card h-100">
                    <div class="event-preview-body">
                        <span class="badge bg-warning text-dark mb-3">@eventItem.EventType</span>
                        <h3>@eventItem.Title</h3>
                        <p class="event-description">
                            @eventItem.EventDate.ToString("dd MMM yyyy") · @eventItem.Venue
                        </p>
                        <div class="event-card-footer">
                            <span>From LKR @eventItem.MinimumTicketPrice.ToString("N2")</span>
                            <a asp-page="/Events/Details"
                               asp-route-id="@eventItem.Id">
                                View tickets →
                            </a>
                        </div>
                    </div>
                </article>
            </div>
        }
    </div>
</div>
