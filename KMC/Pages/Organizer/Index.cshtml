@page
@model KMC.Web.Pages.Organizer.IndexModel

@{
    ViewData["Title"] = "Organizer Workspace";
}

<section class="page-hero page-hero-compact organizer-hero">
    <div class="container">
        <span class="eyebrow-pill">
            <span class="eyebrow-dot"></span>
            Organizer Interface
        </span>
        <div class="page-hero-row">
            <div>
                <h1>Organizer Workspace</h1>
                <p>
                    Create ticketed events, set category prices and capacities, and review public user payments.
                </p>
            </div>
            <a asp-page="/Organizer/Create"
               class="btn btn-kmc-gold">
                + Create Ticketed Event
            </a>
        </div>
    </div>
</section>

<div class="container py-5">
    @if (TempData["OrganizerSuccess"] is string successMessage)
    {
        <div class="alert alert-success alert-dismissible fade show">
            @successMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (TempData["OrganizerError"] is string errorMessage)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            @errorMessage
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
    {
        <div class="alert alert-danger">@Model.ErrorMessage</div>
    }
    @if (!string.IsNullOrWhiteSpace(Model.PartnerErrorMessage))
    {
        <div class="alert alert-warning">@Model.PartnerErrorMessage</div>
    }

    <div class="row g-4 mb-5 organizer-metrics-row">
        <div class="col-md-4">
            <div class="dashboard-stat-card stat-events">
                <span>Total events</span>
                <strong>@Model.TotalEvents</strong>
                <small>Official and connected events</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-stat-card stat-published">
                <span>Published</span>
                <strong>@Model.PublishedEvents</strong>
                <small>Currently visible to the public</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="dashboard-stat-card stat-revenue" aria-live="polite">
                <span>Total revenue</span>
                <strong id="organizerTotalRevenue" class="dashboard-money">LKR @Model.TotalRevenue.ToString("N0")</strong>
                <small id="organizerRevenueUpdated">
                    Approved payments · updated @Model.RevenueUpdatedAt.ToString("hh:mm:ss tt")
                </small>
            </div>
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(Model.RevenueErrorMessage))
    {
        <div class="revenue-sync-note" id="organizerRevenueNotice">@Model.RevenueErrorMessage</div>
    }

    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <span class="section-kicker">Event management</span>
            <h2 class="h3 fw-bold mb-0">My Events</h2>
        </div>
        <span class="text-muted">@Model.Events.Count event(s)</span>
    </div>

    @if (string.IsNullOrWhiteSpace(Model.ErrorMessage) && Model.Events.Count == 0)
    {
        <div class="empty-state-card">
            <h2 class="h4 fw-bold">No events created yet</h2>
            <p>Create your first event and configure three ticket categories.</p>
            <a asp-page="/Organizer/Create"
               class="btn btn-dark">
                Create First Event
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var eventItem in Model.Events)
            {
                var statusBadgeClass = eventItem.Status switch
                {
                    "Published" => "bg-success",
                    "Draft" => "bg-secondary",
                    "Cancelled" => "bg-danger",
                    "Completed" => "bg-primary",
                    _ => "bg-dark"
                };

                <div class="col-md-6 col-xl-4">
                    <article class="organizer-event-card h-100">
                        <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                            <span class="badge bg-warning text-dark">@eventItem.EventType</span>
                            @if (eventItem.HasEnded)
                            {
                                <span class="badge bg-secondary">Ended</span>
                            }
                            else if (eventItem.IsSoldOut)
                            {
                                <span class="badge bg-danger">Sold Out</span>
                            }
                            else
                            {
                                <span class="badge @statusBadgeClass">@eventItem.Status</span>
                            }
                        </div>

                        <h3 class="h5 fw-bold">@eventItem.Title</h3>
                        <p class="text-muted small">
                            @eventItem.EventDate.ToString("dd MMM yyyy")
                            @(eventItem.EndDate.Date != eventItem.EventDate.Date ? $" – {eventItem.EndDate:dd MMM yyyy}" : "") ·
                            @eventItem.StartTime.ToString(@"hh\:mm") ·
                            @eventItem.Venue
                        </p>

                        <div class="organizer-ticket-summary">
                            @foreach (var tier in eventItem.TicketTiers.OrderBy(item => item.SortOrder))
                            {
                                <div>
                                    <span>@tier.Name</span>
                                    <strong>LKR @tier.Price.ToString("N0")</strong>
                                    <small>@tier.SoldCount / @tier.Capacity sold</small>
                                </div>
                            }
                        </div>

                        <div class="event-meta-row mt-3">
                            <span>@eventItem.RegisteredParticipantCount tickets sold</span>
                            <span>@eventItem.Capacity total capacity</span>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4">
                            @if (string.Equals(
                                eventItem.Status,
                                "Published",
                                StringComparison.OrdinalIgnoreCase))
                            {
                                <a asp-page="/Events/Details"
                                   asp-route-id="@eventItem.Id"
                                   class="btn btn-outline-dark btn-sm">
                                    Public View
                                </a>
                            }

                            <a asp-page="/Organizer/Edit"
                               asp-route-id="@eventItem.Id"
                               class="btn btn-outline-primary btn-sm">
                                Edit Event
                            </a>

                            <a asp-page="/Organizer/Participants"
                               asp-route-id="@eventItem.Id"
                               class="btn btn-outline-success btn-sm">
                                Sales & Public Users
                            </a>

                            <form asp-page="/Organizer/Index"
                                  asp-page-handler="Delete"
                                  asp-route-id="@eventItem.Id"
                                  method="post"
                                  onsubmit="return confirm('Delete this event and its related ticket/payment records? This action cannot be undone.');">
                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">
                                    Delete
                                </button>
                            </form>
                        </div>
                    </article>
                </div>
            }
        </div>
    }

    <section class="connected-events-section mt-5 pt-4">
        <div class="events-section-heading partner-heading">
            <div>
                <span class="section-kicker">Connected event management</span>
                <h2>Events from your personal website</h2>
                <p class="text-muted mb-0">
                    Synchronized events can now be edited, reviewed and deleted directly from this KMC workspace.
                </p>
            </div>
            <span>@Model.PartnerEvents.Count event(s)</span>
        </div>

        @if (Model.PartnerEvents.Count == 0)
        {
            <div class="empty-state-card connected-empty-state">
                <h3 class="h5 fw-bold">No connected website events yet</h3>
                <p class="mb-0">Events published from the matching organizer website will appear here automatically.</p>
            </div>
        }
        else
        {
            <div class="row g-4">
                @foreach (var partnerEvent in Model.PartnerEvents)
                {
                    var partnerStatusBadgeClass = partnerEvent.IsPublished
                        ? "bg-success"
                        : "bg-secondary";
                    var partnerStatusText = partnerEvent.IsPublished
                        ? "Published"
                        : "Draft";

                    <div class="col-md-6 col-xl-4">
                        <article class="organizer-event-card h-100 connected-event-card">
                            <div class="d-flex justify-content-between align-items-start gap-2 mb-3">
                                <div class="d-flex flex-wrap gap-2">
                                    <span class="badge bg-warning text-dark">@partnerEvent.EventType</span>
                                    <span class="badge connected-source-badge">Connected source</span>
                                </div>
                                @if (partnerEvent.HasEnded)
                                {
                                    <span class="badge bg-secondary">Ended</span>
                                }
                                else if (partnerEvent.IsSoldOut)
                                {
                                    <span class="badge bg-danger">Sold Out</span>
                                }
                                else
                                {
                                    <span class="badge @partnerStatusBadgeClass">@partnerStatusText</span>
                                }
                            </div>

                            <h3 class="h5 fw-bold">@partnerEvent.Title</h3>
                            <p class="text-muted small">
                                @partnerEvent.EventDate.ToString("dd MMM yyyy")
                                @(partnerEvent.EndDate.Date != partnerEvent.EventDate.Date ? $" – {partnerEvent.EndDate:dd MMM yyyy}" : "") ·
                                @partnerEvent.StartTime.ToString(@"hh\:mm") ·
                                @partnerEvent.Venue
                            </p>

                            <div class="organizer-ticket-summary">
                                @foreach (var tier in partnerEvent.TicketTiers.OrderBy(item => item.SortOrder))
                                {
                                    <div>
                                        <span>@tier.Name</span>
                                        <strong>LKR @tier.Price.ToString("N0")</strong>
                                        <small>@tier.SoldCount / @tier.Capacity sold</small>
                                    </div>
                                }
                            </div>

                            <div class="event-meta-row mt-3">
                                <span>@partnerEvent.RegisteredParticipantCount tickets sold</span>
                                <span>@partnerEvent.TotalCapacity total capacity</span>
                            </div>

                            <div class="connected-sync-note">
                                <span>Last synchronized</span>
                                <strong>@partnerEvent.LastSyncedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</strong>
                            </div>

                            <div class="d-flex flex-wrap gap-2 mt-4">
                                @if (partnerEvent.IsPublished)
                                {
                                    <a asp-page="/PartnerEvents/Details"
                                       asp-route-id="@partnerEvent.Id"
                                       class="btn btn-outline-dark btn-sm">
                                        Public View
                                    </a>
                                }

                                <a asp-page="/Organizer/PartnerEdit"
                                   asp-route-id="@partnerEvent.Id"
                                   class="btn btn-outline-primary btn-sm">
                                    Edit Event
                                </a>

                                <a asp-page="/Organizer/PartnerParticipants"
                                   asp-route-id="@partnerEvent.Id"
                                   class="btn btn-outline-success btn-sm">
                                    Sales &amp; Public Users
                                </a>

                                <form asp-page="/Organizer/Index"
                                      asp-page-handler="DeletePartner"
                                      asp-route-id="@partnerEvent.Id"
                                      method="post"
                                      onsubmit="return confirm('Delete this connected event from both the organizer website and KMC? This action cannot be undone.');">
                                    <button type="submit"
                                            class="btn btn-outline-danger btn-sm">
                                        Delete
                                    </button>
                                </form>
                            </div>
                        </article>
                    </div>
                }
            </div>
        }
    </section>
</div>


@section Scripts {
    <script>
        (() => {
            const revenueValue = document.getElementById('organizerTotalRevenue');
            const revenueUpdated = document.getElementById('organizerRevenueUpdated');
            const revenueNotice = document.getElementById('organizerRevenueNotice');
            const endpoint = '@Url.Page("/Organizer/Index", "Revenue")';

            const refreshRevenue = async () => {
                try {
                    const response = await fetch(endpoint, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        cache: 'no-store'
                    });

                    if (!response.ok) return;
                    const data = await response.json();
                    if (revenueValue) revenueValue.textContent = data.formattedRevenue;
                    if (revenueUpdated) {
                        revenueUpdated.textContent = `Approved payments · updated ${data.updatedAt}`;
                    }
                    if (revenueNotice && data.isComplete) revenueNotice.remove();
                } catch {
                    // Keep the most recently loaded value when a background refresh fails.
                }
            };

            window.setInterval(refreshRevenue, 15000);
        })();
    </script>
}
