@model KMC.Web.Models.Organizer.EventFormViewModel

<div asp-validation-summary="ModelOnly"
     class="alert alert-danger"></div>

<div class="row g-3">
    <div class="col-12">
        <label asp-for="Title" class="form-label"></label>
        <input asp-for="Title"
               class="form-control"
               placeholder="Enter the event title" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Description" class="form-label"></label>
        <textarea asp-for="Description"
                  class="form-control"
                  rows="4"
                  placeholder="Describe the event"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="EventType" class="form-label"></label>
        <input asp-for="EventType"
               class="form-control"
               placeholder="Music, Sports, Education..." />
        <span asp-validation-for="EventType" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Status" class="form-label"></label>
        <select asp-for="Status" class="form-select">
            <option value="Draft">Draft</option>
            <option value="Published">Published</option>
            @if (Model.Id > 0)
            {
                <option value="Cancelled">Cancelled</option>
                <option value="Completed">Completed</option>
            }
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="EventDate" class="form-label"></label>
        <input asp-for="EventDate" type="date" class="form-control" />
        <span asp-validation-for="EventDate" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="StartTime" class="form-label"></label>
        <input asp-for="StartTime" type="time" class="form-control" />
        <span asp-validation-for="StartTime" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="EndDate" class="form-label"></label>
        <input asp-for="EndDate" type="date" class="form-control" />
        <span asp-validation-for="EndDate" class="text-danger"></span>
    </div>

    <div class="col-md-3">
        <label asp-for="EndTime" class="form-label"></label>
        <input asp-for="EndTime" type="time" class="form-control" />
        <span asp-validation-for="EndTime" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Venue" class="form-label"></label>
        <input asp-for="Venue"
               class="form-control"
               placeholder="KMC Hall" />
        <span asp-validation-for="Venue" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Location" class="form-label"></label>
        <input asp-for="Location"
               class="form-control"
               placeholder="Kandy" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
</div>

<section class="ticket-builder mt-5">
    <div class="d-flex flex-column flex-md-row justify-content-between gap-2 mb-3">
        <div>
            <span class="section-kicker">Ticket configuration</span>
            <h2 class="h4 fw-bold mb-1">Create three ticket categories</h2>
            <p class="text-muted mb-0">
                Set the category name, price and available quantity manually.
            </p>
        </div>
        <div class="ticket-total-chip">
            Total capacity: <strong id="totalTicketCapacity">@Model.Capacity</strong>
        </div>
    </div>

    <span asp-validation-for="TicketTiers" class="text-danger d-block mb-3"></span>

    <div class="row g-3">
        @for (var index = 0; index < Model.TicketTiers.Count; index++)
        {
            var tierLabel = index switch
            {
                0 => "Entry tier",
                1 => "Enhanced tier",
                _ => "Premium tier"
            };

            <div class="col-lg-4">
                <div class="ticket-tier-editor h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-warning text-dark">@(index + 1)</span>
                        <small class="text-muted">@tierLabel</small>
                    </div>

                    <input asp-for="TicketTiers[index].Id" type="hidden" />
                    <input asp-for="TicketTiers[index].SortOrder" type="hidden" />

                    <div class="mb-3">
                        <label asp-for="TicketTiers[index].Name"
                               class="form-label"></label>
                        <input asp-for="TicketTiers[index].Name"
                               class="form-control"
                               placeholder="Standard" />
                        <span asp-validation-for="TicketTiers[index].Name"
                              class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="TicketTiers[index].Price"
                               class="form-label"></label>
                        <div class="input-group">
                            <span class="input-group-text">LKR</span>
                            <input asp-for="TicketTiers[index].Price"
                                   class="form-control"
                                   min="0"
                                   step="0.01" />
                        </div>
                        <span asp-validation-for="TicketTiers[index].Price"
                              class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="TicketTiers[index].Capacity"
                               class="form-label"></label>
                        <input asp-for="TicketTiers[index].Capacity"
                               class="form-control ticket-capacity-input"
                               min="1" />
                        <span asp-validation-for="TicketTiers[index].Capacity"
                              class="text-danger"></span>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="alert alert-info mt-3 mb-0">
        The overall event capacity is calculated automatically from the three ticket quantities.
    </div>
</section>
