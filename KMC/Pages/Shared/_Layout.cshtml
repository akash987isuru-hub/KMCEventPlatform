@{
    var currentPage =
        ViewContext.RouteData.Values["page"]?.ToString() ?? string.Empty;

    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isOrganizer = isAuthenticated && User.IsInRole("Organizer");
    var isParticipant = isAuthenticated && User.IsInRole("Participant");

    var userName = User.Identity?.Name ?? "User";
    var userInitial = string.IsNullOrWhiteSpace(userName)
        ? "U"
        : userName.Trim()[0].ToString().ToUpperInvariant();

    var brandPage = isOrganizer
        ? "/Organizer/Home"
        : isParticipant
            ? "/Participant/Home"
            : "/Index";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - KMC Event Platform</title>
    <meta name="description"
          content="Discover, organize and manage trusted city events across Kandy." />
    <meta name="theme-color" content="#07111b" />

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/KMC.Web.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/dark-theme.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/professional-ui.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/municipal-theme.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/platform-refresh.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/experience-refresh.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/final-polish.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/colorful-redesign.css"
          asp-append-version="true" />
</head>

<body class="d-flex flex-column min-vh-100 kmc-dark-theme">
    <div class="page-atmosphere" aria-hidden="true"></div>

    <header class="site-header">
        <nav class="navbar navbar-expand-xl navbar-dark kmc-navbar">
            <div class="container">
                <a class="navbar-brand kmc-brand"
                   asp-page="@brandPage"
                   aria-label="KMC Events home">
                    <span class="brand-mark" aria-hidden="true">K</span>
                    <span class="brand-copy">
                        <strong>KMC Events</strong>
                        <small>Kandy Municipal Council</small>
                    </span>
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavigation"
                        aria-controls="mainNavigation"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse"
                     id="mainNavigation">
                    <ul class="navbar-nav mx-xl-auto mb-3 mb-xl-0 kmc-nav-links">
                        @if (isOrganizer)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Organizer/Home" ? "active" : string.Empty)"
                                   asp-page="/Organizer/Home">
                                    Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentPage.StartsWith("/Organizer", StringComparison.OrdinalIgnoreCase) && currentPage != "/Organizer/Home" ? "active" : string.Empty)"
                                   asp-page="/Organizer/Index">
                                    Workspace
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentPage.StartsWith("/Events", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                                   asp-page="/Events/Index">
                                    Explore Events
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/About" ? "active" : string.Empty)"
                                   asp-page="/About">
                                    About
                                </a>
                            </li>
                        }
                        else if (isParticipant)
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Participant/Home" ? "active" : string.Empty)"
                                   asp-page="/Participant/Home">
                                    Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Participant/Index" ? "active" : string.Empty)"
                                   asp-page="/Participant/Index">
                                    Dashboard
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentPage.StartsWith("/Events", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                                   asp-page="/Events/Index">
                                    Explore Events
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentPage.StartsWith("/Registrations", StringComparison.OrdinalIgnoreCase) || currentPage.StartsWith("/Checkout", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                                   asp-page="/Registrations/Index">
                                    My Tickets
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/About" ? "active" : string.Empty)"
                                   asp-page="/About">
                                    About
                                </a>
                            </li>
                        }
                        else
                        {
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/Index" ? "active" : string.Empty)"
                                   asp-page="/Index">
                                    Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentPage.StartsWith("/Events", StringComparison.OrdinalIgnoreCase) ? "active" : string.Empty)"
                                   asp-page="/Events/Index">
                                    Explore Events
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @(currentPage == "/About" ? "active" : string.Empty)"
                                   asp-page="/About">
                                    About
                                </a>
                            </li>
                        }
                    </ul>

                    <div class="d-flex flex-column flex-xl-row align-items-xl-center gap-2">
                        @if (isAuthenticated)
                        {
                            <div class="user-chip">
                                <span class="user-avatar">@userInitial</span>
                                <span class="user-chip-copy">
                                    <small>Signed in as</small>
                                    <strong>@userName</strong>
                                </span>
                                <span class="role-pill @(isOrganizer ? "role-organizer" : "role-participant")">
                                    @(isOrganizer ? "Organizer" : "Public User")
                                </span>
                            </div>

                            <form asp-page="/Account/Logout"
                                  method="post"
                                  class="d-inline">
                                <button type="submit"
                                        class="btn btn-nav-outline">
                                    Logout
                                </button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-nav-link"
                               asp-page="/Account/Login">
                                Login
                            </a>

                            <a class="btn btn-kmc-gold"
                               asp-page="/Account/Register">
                                Create Account
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main class="flex-grow-1 site-main">
        @RenderBody()
    </main>

    <footer class="kmc-footer mt-auto">
        <div class="container">
            <div class="footer-grid footer-grid-clean">
                <div class="footer-brand">
                    <span class="brand-mark brand-mark-small" aria-hidden="true">K</span>
                    <div>
                        <strong>KMC Event Platform</strong>
                        <small>A trusted digital event service for the Kandy community.</small>
                    </div>
                </div>

                <div class="footer-assurance" aria-label="Platform assurances">
                    <span>Secure access</span>
                    <span>Role-based services</span>
                    <span>Citywide discovery</span>
                </div>

                <div class="footer-meta">
                    <span>&copy; 2026 Kandy Municipal Council</span>
                    <span>Service-Oriented Event Management Platform</span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
